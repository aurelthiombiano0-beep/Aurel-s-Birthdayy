{
  "entities": {
    "memory": {
      "title": "Memory",
      "description": "A shared photo or video memory from the event",
      "type": "object",
      "properties": {
        "url": { "type": "string", "description": "URL of the memory file" },
        "type": { "type": "string", "enum": ["image", "video"], "description": "Type of media" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When it was uploaded" },
        "firstName": { "type": "string", "description": "First name of uploader" },
        "lastName": { "type": "string", "description": "Last name of uploader" },
        "authorId": { "type": "string", "description": "UID of the uploader (anonymous)" }
      },
      "required": ["url", "type", "createdAt", "firstName", "lastName", "authorId"]
    }
  },
  "firestore": {
    "memories": {
      "schema": "memory",
      "description": "Shared collection of all event memories"
    }
  }
}
