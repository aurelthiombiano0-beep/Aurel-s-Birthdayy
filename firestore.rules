rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for Memory entity
    function isValidMemory(data) {
      return data.keys().hasAll(['url', 'type', 'createdAt', 'firstName', 'lastName', 'authorId']) 
             && data.keys().size() >= 6
             && data.url is string && data.url.size() < 2048
             && data.type in ['image', 'video']
             && data.createdAt == request.time
             && data.firstName is string && data.firstName.size() <= 50
             && data.lastName is string && data.lastName.size() <= 50
             && data.authorId is string && data.authorId.size() <= 100;
    }

    // Memories collection
    match /memories/{memoryId} {
      allow list, get: if true; 
      
      allow create: if isValidId(memoryId) && isValidMemory(incoming());
      
      // Allow "deletion" by updating a deleted flag, verified by the authorId secret
      allow update: if existing().authorId != null 
                    && incoming().authorId == existing().authorId
                    && (
                      // Allow marking as deleted
                      (incoming().deleted == true && request.resource.data.diff(resource.data).affectedKeys().hasAll(['deleted']))
                    );

      allow delete: if false; // Use update to flag as deleted for non-auth security
    }
  }
}
